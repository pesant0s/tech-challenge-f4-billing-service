# MongoDB do docker compose (replica set de 1 nó: transações exigem replica set); no EKS o MongoDB é do próprio namespace
MONGO_URL=mongodb://mongo:27017/?directConnection=true
MONGO_DB=billing

# SECRET_KEY precisa ser a mesma do OS Service, que emite os tokens
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-chars
ALGORITHM=HS256
ALLOWED_ORIGINS=["http://localhost:3000"]

# Sem RABBITMQ_URL a API sobe sem consumir comandos, publicar eventos nem conciliar pagamentos
RABBITMQ_URL=amqp://oficina:oficina@rabbitmq:5672/%2F

# simulado (padrão) ou mercadopago; o Mercado Pago exige MP_ACCESS_TOKEN e MP_EXTERNAL_POS_ID
PAGAMENTO_PROVEDOR=simulado
MP_API_URL=https://api.mercadopago.com
MP_ACCESS_TOKEN=
MP_EXTERNAL_POS_ID=
MP_WEBHOOK_SECRET=

PAGAMENTO_EXPIRACAO_MINUTOS=15
ORCAMENTO_VALIDADE_MINUTOS=1440
CONCILIACAO_SEGUNDOS=15

# Sem licença, o agente do New Relic fica desligado
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=tech-challenge-f4-billing-service

LOG_FORMAT=console
LOG_LEVEL=INFO

# Prefixo do Swagger/OpenAPI (em produção: /billing); vazio localmente
PREFIXO_DOCS=
